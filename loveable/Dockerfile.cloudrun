# ============================
# Stage 1: Build
# ============================
FROM --platform=linux/amd64 node:20-bullseye AS builder

WORKDIR /app

# Copy package files first
COPY package*.json ./

# Build args for environment variables
ARG VITE_API_URL
ARG VITE_STRIPE_PUBLISHABLE_KEY
ARG VITE_BASE_PATH
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_STRIPE_PUBLISHABLE_KEY=$VITE_STRIPE_PUBLISHABLE_KEY
ENV VITE_BASE_PATH=$VITE_BASE_PATH

# Install dependencies
RUN npm install

# Copy rest of the code
COPY . .

# Ensure local env files do not override CI-provided VITE_* build args
RUN rm -f .env .env.local .env.development .env.production || true

# Build the static app
RUN npm run build

# ============================
# Stage 2: Production
# ============================
FROM --platform=linux/amd64 nginx:stable-alpine

WORKDIR /usr/share/nginx/html

# Copy built files
COPY --from=builder /app/dist .

# Use Cloud Run compatible nginx config (no backend proxy)
COPY nginx.cloudrun.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
