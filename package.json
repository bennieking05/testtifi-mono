{
  "name": "testifiai-repo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "loveable"
  ],
  "scripts": {
    "dev": "concurrently -n be,fe \"npm run dev -w backend\" \"npm run dev -w loveable\"",
    "build": "npm run build --workspaces",
    "start": "npm start -w backend",
    "start:worker": "npm run start:worker -w backend",
    "start:cleanup": "npm run start:cleanup -w backend",
    "test:ui": "playwright test -c playwright.config.ts",
    "test:uat:mock": "node scripts/uat-mock-tests.mjs",
    "scrape:webcopy": "node scripts/scrape-webcopy.mjs",
    "test:regression": "node scripts/run-regression.mjs",
    "test:regression:local": "node scripts/run-regression.mjs local",
    "test:regression:staging": "node scripts/run-regression.mjs staging",
    "test:regression:prod": "node scripts/run-regression.mjs prod",
    "test:api": "node scripts/api-regression.mjs",
    "test:api:local": "node scripts/api-regression.mjs local",
    "test:api:staging": "node scripts/api-regression.mjs staging",
    "test:frontend": "npx playwright test tests/regression/",
    "test:e2e": "npx playwright test",
    "test:evidence": "npx playwright test tests/evidence/",
    "watch:summary": "npx ts-node scripts/watch-local-summary.ts",
    "watch:summary:once": "npx ts-node scripts/watch-local-summary.ts --once"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.12.1",
    "@google-cloud/vision": "^4.3.3",
    "@prisma/client": "^6.2.1",
    "@sendgrid/mail": "^8.1.0",
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "csv-stringify": "^6.5.1",
    "docx": "^9.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.7.2",
    "multer": "^1.4.5-lts.1",
    "p-limit": "^5.0.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.14.0",
    "stripe": "^19.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "@playwright/test": "^1.48.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.5",
    "@types/busboy": "^1.5.2",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.12.12",
    "@types/pdf-parse": "^1.1.3",
    "@types/pdfkit": "^0.12.12",
    "prisma": "^6.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
