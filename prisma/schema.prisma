generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "darwin-arm64"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// ───────────────────────── models ────────────────────────
model User {
  id             String            @id @default(uuid())
  email          String            @unique
  password       String
  name           String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  resetToken     String?
  resetTokenExp  DateTime?
  credits        Int               @default(0)
  companyName    String?
  role           Role              @default(user)
  downloads      DownloadHistory[]
  files          File[]
  purchases      Purchase[]
  refreshTokens  RefreshToken?
  supportTickets SupportTicket[]
  trainingAssets TrainingAsset[]
  ledgerEntries  LedgerEntry[]
}

model File {
  id              String            @id @default(uuid())
  fileName        String
  fileUrl         String
  createdAt       DateTime          @default(now())
  userId          String?
  summaryFileName String?
  summaryUrl      String?           @db.Text
  pages           Int?              @default(0)
  deponent        String?
  title           String
  downloads       DownloadHistory[]
  user            User?             @relation(fields: [userId], references: [id])
  summaryJobs     SummaryJob[]      @relation("FileToSummaryJob")

  @@index([userId], map: "File_userId_fkey")
}

model SummaryJob {
  id                String   @id @default(uuid())

  /* ───── relations ───── */
  userId            String
  fileId            String?
  file              File?    @relation("FileToSummaryJob", fields: [fileId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_SummaryJob_file")

  /* ───── file info ───── */
  fileName          String
  fileUrl           String
  summaryCsvUrl     String?  @db.Text

  /* ───── job status ───── */
  status            String
  lastPageProcessed Int
  totalPages        Int
  error             String?  @db.Text
  notifyOnComplete  Boolean  @default(false)

  /* ───── timing  ───── */
  startedAt         DateTime @default(now())  // when the row is inserted
  finishedAt        DateTime?                 // filled by the worker on success

  /* ───── bookkeeping ─── */
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([fileId], map: "fk_SummaryJob_file")
}
model Purchase {
  id                     String             @id @default(uuid())
  userId                 String
  stripePaymentIntentId  String             @unique
  amountCents            Int
  currency               String             @default("usd")
  creditsAdded           Int
  status                 PurchaseStatus     @default(succeeded)
  receiptUrl             String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id])
  ledgerEntries          LedgerEntry[]
  creditAllocations      CreditAllocation[]

  @@index([userId], map: "Purchase_userId_fkey")
}

model LedgerEntry {
  id              String             @id @default(uuid())
  userId          String
  type            LedgerEntryType
  credits         Int
  summaryId       String?
  description     String?
  idempotencyKey  String             @unique
  purchaseId      String?
  createdAt       DateTime           @default(now())
  user            User               @relation(fields: [userId], references: [id])
  purchase        Purchase?          @relation(fields: [purchaseId], references: [id])
  creditAllocations CreditAllocation[]

  @@index([userId, createdAt])
}

model CreditAllocation {
  id             String      @id @default(uuid())
  debitLedgerId  String
  purchaseId     String
  creditsUsed    Int
  debitLedger    LedgerEntry @relation(fields: [debitLedgerId], references: [id])
  purchase       Purchase    @relation(fields: [purchaseId], references: [id])

  @@index([debitLedgerId])
  @@index([purchaseId])
}

model Email {
  id      Int    @id @default(autoincrement())
  subject String
  body    String @db.VarChar(10000)
}

model RefreshToken {
  id              String    @id @default(uuid())
  token           String    @db.Text
  userId          String    @unique
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  revoked         Boolean   @default(false)
  revokedAt       DateTime?
  replacedByToken String?   @db.Text
  user            User      @relation(fields: [userId], references: [id])
}

model SupportTicket {
  id        String         @id @default(cuid())
  userId    String?
  name      String
  email     String
  subject   String
  message   String         @db.Text
  status    SupportStatus  @default(OPEN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  replies   SupportReply[]
  user      User?          @relation(fields: [userId], references: [id])

  @@index([userId], map: "SupportTicket_userId_fkey")
}

model SupportReply {
  id        String        @id @default(cuid())
  ticketId  String
  from      ReplyAuthor
  message   String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId], map: "SupportReply_ticketId_fkey")
}

model DownloadHistory {
  id        String   @id @default(cuid())
  userId    String
  fileId    String
  format    String
  createdAt DateTime @default(now())
  file      File     @relation(fields: [fileId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([fileId], map: "DownloadHistory_fileId_fkey")
  @@index([userId], map: "DownloadHistory_userId_fkey")
}

model TrainingAsset {
  id          String    @id @default(uuid())
  userId      String
  type        AssetType
  filename    String
  fileSize    Int
  uploadedAt  DateTime  @default(now())
  description String?
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId], map: "TrainingAsset_userId_fkey")
}

/// ───────────────────────── enums ─────────────────────────
enum Role {
  user
  admin
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum ReplyAuthor {
  support
  user
}

enum AssetType {
  human_summary
  training_pair
  generated_pair
}

enum PurchaseStatus {
  succeeded
  refunded
  partially_refunded
  requires_payment_method
}

enum LedgerEntryType {
  credit
  debit
  adjustment
}
