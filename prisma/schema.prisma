generator client {
  provider = "prisma-client-js"
  // Add the relevant binary targets here
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  name           String
  credits        Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  resetToken     String?
  resetTokenExp  DateTime?
  files          File[]
  purchases      Purchase[]
  refreshTokens  RefreshToken[]  // New field added to complete the relation
}

model File {
  id              String   @id @default(uuid())
  fileName        String
  fileUrl         String
  summaryFileName String?  // New optional field for the summary file name
  summaryUrl      String?  @db.Text // New optional field for the summary download URL, using TEXT type
  pages           Int?     @default(0) // New optional field for the page count
  createdAt       DateTime @default(now())

  // Relation to User
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
}

model Purchase {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  credits    Int
  amount     Float
  createdAt  DateTime @default(now())
}

model Email {
  id      Int    @id @default(autoincrement())
  subject String
  body    String @db.VarChar(10000)
}

model RefreshToken {
  id              String   @id @default(uuid())
  token           String   @unique @db.VarChar(512)
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  revoked         Boolean  @default(false)
  revokedAt       DateTime?
  replacedByToken String?  @db.VarChar(512) // Optional, if you implement token rotation
}