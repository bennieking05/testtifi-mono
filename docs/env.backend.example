# Backend (.env) — example values only, do NOT commit real secrets
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Choose one database
# DB_URL=postgresql://user:pass@localhost:5432/testifi
# MONGO_URL=mongodb://user:pass@localhost:27017/testifi

# Storage & email
